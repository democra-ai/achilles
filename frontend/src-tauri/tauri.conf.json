{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "Achilles Vault",
  "version": "1.0.5",
  "identifier": "com.achilles.vault",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Achilles Vault",
        "width": 1200,
        "height": 800,
        "center": true,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8900 http://localhost:8900 http://127.0.0.1:8901 http://localhost:8901; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["achillesvault"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/achilles-server"],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Tao Shen (HNU7NA3S7L)",
      "entitlements": "Achilles_Vault.entitlements"
    },
    "resources": []
  }
}